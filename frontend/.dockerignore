# Allow only application build inputs; new developer files are excluded by default.
**
!package.json
!bun.lock
!next.config.ts
!proxy.ts
!tsconfig.json
!postcss.config.mjs
!app/
!app/**
!components/
!components/**
!context/
!context/**
!lib/
!lib/**
!public/
!public/**

# Deny secret/credential variants even inside an allowed source directory.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.aws
**/.aws/**
**/.ssh
**/.ssh/**
**/.npmrc
**/.netrc
**/*credentials*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.git
**/.git/**
**/.DS_Store
**/node_modules
**/node_modules/**
**/.next
**/.next/**
**/*.log
**/*.test.*
**/*.spec.*
**/coverage
**/coverage/**
**/test-results
**/test-results/**
**/tsconfig.tsbuildinfo
