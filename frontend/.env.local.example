# Server-only Spring origin for Next's /api proxy (no path or credentials).
# For local Next + Maven/IDE launches. Restart next dev after changing it.
API_PROXY_TARGET=http://localhost:8080

# Browser calls remain relative /api URLs. Do not configure NEXT_PUBLIC_API_BASE_URL.
# next build captures API_PROXY_TARGET; changing it for next start requires a rebuild.
# The Dockerfile defaults to http://backend:8080 on the Compose network.

# Server runtime flag: leave false for local HTTP (including next start/Compose).
# Set true only behind a controlled HTTPS-only ingress with direct access blocked.
HTTPS_DEPLOYMENT=false
