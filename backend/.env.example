# Local Maven/IDE environment template; .env files are NOT loaded automatically.
# AWS must activate aws-dev or prod; see backend/CONFIGURATION.md.
SPRING_PROFILES_ACTIVE=local

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/veteran_connection
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT — required even for local Maven/IDE launches. This file is not loaded automatically.
# Generate a distinct random value per environment: openssl rand -base64 32
JWT_SECRET=replace_this_with_output_of_openssl_rand_base64_32
# JWT_EXPIRATION=86400000

# Logging
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_COM_VETERANSCONNECT=DEBUG

# Server
# SERVER_PORT=8080

# Reverse proxy (AWS aws-dev/prod only; exact immediate-peer literal IPs).
# Required for deployed profiles; leave unset for direct local HTTP.
# TRUSTED_PROXY_IPS=replace_with_actual_controlled_proxy_ips
# Never enable Boot's framework/native forwarding globally.
# SERVER_FORWARD_HEADERS_STRATEGY=none
# AUTH_RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
