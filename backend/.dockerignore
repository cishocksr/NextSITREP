# Default-deny context: Maven/bootstrap inputs and sources needed by verify only.
**
!pom.xml
!mvnw
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties
!src/
!src/**

# Deny nested local/private material even inside permitted source directories.
**/.env*
**/*.env
**/*.env.*
**/.aws
**/.aws/**
**/.ssh
**/.ssh/**
**/.npmrc
**/.netrc
**/*credentials*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.git
**/.git/**
**/.DS_Store
**/target
**/target/**
**/.idea
**/.idea/**
**/.settings
**/.settings/**
**/*.log
**/*.db
**/*.sqlite*
**/coverage
**/coverage/**
**/test-results
**/test-results/**
