# ─────────────────────────────────────────────────────────────────────────────
# VeteransConnect — Environment Variables
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values below
#   3. NEVER commit .env to git — it is already in .gitignore
#
# The .env file is loaded automatically by Docker Compose.
# ─────────────────────────────────────────────────────────────────────────────


# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=veteran_connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_PORT=5432


# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secure random key:  openssl rand -base64 32
# Must be Base64-encoded and at least 32 bytes for HS256.
JWT_SECRET=replace_this_with_output_of_openssl_rand_base64_32

# Token lifetime in milliseconds
# 86400000 = 24 hours (good for development)
# 3600000  = 1 hour   (recommended for production)
JWT_EXPIRATION=86400000
JWT_COOKIE_NAME=vc_session
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_MS=900000


# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
# Development:  http://localhost:3000
# Production:   https://yourdomain.com  (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000


# ─── VA Facilities API ────────────────────────────────────────────────────────
# Get a FREE sandbox key — instant approval, no waiting:
#   1. Go to https://developer.va.gov/apply
#   2. Select "VA Facilities" from the API list
#   3. Fill out the short form and check your email for the key
VA_API_KEY=your_va_api_key_here
VA_API_BASE_URL=https://sandbox-api.va.gov
VA_API_CONNECT_TIMEOUT_MS=2000
VA_API_READ_TIMEOUT_MS=5000
GEOCODING_CONNECT_TIMEOUT_MS=2000
GEOCODING_READ_TIMEOUT_MS=3000
GEOCODING_CACHE_ENABLED=true


# ─── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_SHOW_SQL=false
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_COM_VETERANSCONNECT=INFO


# ─── pgAdmin (optional — docker compose --profile tools up) ──────────────────
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050


# ─── Frontend ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
FRONTEND_PORT=3000
